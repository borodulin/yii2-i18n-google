{
    "name": "conquer/i18n",
    "description": "The I18n automatic translation extension for the Yii2 framework",
    "keywords": [
        "yii2",
        "i18n",
        "google-translate",
        "yandex-translate"
    ],
    "homepage": "https://github.com/borodulin/yii2-i18n-google",
    "type": "yii2-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/borodulin/yii2-i18n-google/issues",
        "source": "https://github.com/borodulin/yii2-i18n-google"
    },
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": "^2.0.13",
        "conquer/helpers": "^2.2",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "conquer\\i18n\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.3.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "conquer\\i18n\\tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    }
}
